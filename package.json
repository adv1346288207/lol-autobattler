{
  "name": "uucard-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "悠悠牌同款：8人自动战斗卡牌 MVP（核心模拟器 + CLI）",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx cli/main.ts",
    "web": "vite",
    "web:build": "vite build",
    "play": "node scripts/play-web.mjs",
    "serve:dist": "node scripts/serve-static.mjs --dir dist --prefix /lol-autobattler --port 4191",
    "web:preview": "vite preview --port 4173",
    "assets:check": "node scripts/verify-assets.mjs",
    "assets:lol": "node scripts/fetch-lol-assets.mjs",
    "assets:lol:latest": "node scripts/fetch-lol-assets.mjs --latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
